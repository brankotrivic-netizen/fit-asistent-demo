        "jsCode": "const request = $input.first().json;\nconst headers = request.headers || {};\nconst providedSecret = String(headers['x-buma-secret'] || '');\nconst expectedSecret = String($env.N8N_SHARED_SECRET || '');\nconst valid = Boolean(expectedSecret) && providedSecret === expectedSecret;\nreturn [{ json: {\n  valid,\n  http_status: valid ? 200 : 403,\n  error: valid ? '' : 'Invalid shared secret'\n} }];"
      },
      "id": "92bb1e0c-bd36-4f41-b664-998042861462",
      "name": "Validate live-inbox secret",
