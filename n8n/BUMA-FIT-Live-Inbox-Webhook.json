        "jsCode": "const rows = $input.all()\n  .map((item) => item.json || {})\n  .filter((row) => Object.keys(row).length > 0)\n  .slice(0, 100);\nreturn [{ json: {\n  success: true,\n  source: 'FIT Inbound Emails',\n  count: rows.length,\n  items: rows\n} }];"
      },
