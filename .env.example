# Dejanski n8n webhook, ki vrne zapise iz tabele "FIT Inbound Emails".
N8N_LIVE_INBOX_URL=https://your-n8n.example/webhook/fit-live-inbox

# n8n webhook za človeške potrditve. Vrednosti ne dodajajte v frontend ali Git.
N8N_ORDER_ACTION_URL=https://your-n8n.example/webhook/fit-order-action
N8N_SHARED_SECRET=replace-with-a-long-random-secret

# Med razvojem naj ostane true. Produkcijsko pošiljanje omogočite šele po ločenem testu.
N8N_TEST_MODE=true
